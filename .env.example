# Qwen3.8-Flash via Alibaba Cloud DashScope's OpenAI-compatible endpoint.
# This is the preferred variable name from the Qwen API reference.
DASHSCOPE_API_KEY=
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen3.8-flash

# V2 local RAG (CPU is the default for macOS without a discrete GPU)
RAG_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RAG_EMBEDDING_DEVICE=cpu
# Set to hashing only when Hugging Face model download is unavailable.
# RAG_EMBEDDING_BACKEND=hashing
# Optional absolute path overrides:
# RAG_INDEX_DIR=/absolute/path/to/data/vector_db

# Optional backwards-compatible alias. Use either this or DASHSCOPE_API_KEY.
LLM_API_KEY=

# duckduckgo needs no key and is the default. Other options: tavily, serper,
# brave, or bing. Configure the matching key when using one of them.
WEB_SEARCH_PROVIDER=duckduckgo
TAVILY_API_KEY=
SERPER_API_KEY=
BRAVE_SEARCH_API_KEY=
BING_SEARCH_API_KEY=

# Optional HTTP timeout for search tools.
RESEARCH_AGENT_HTTP_TIMEOUT=15

# V4 single-task context management. These are token estimates, not billing
# token counts; Chinese/English text is estimated without a model tokenizer.
CONTEXT_ENABLED=true
CONTEXT_RESEARCHER_TOP_K=6
CONTEXT_WRITER_TOP_K=10
CONTEXT_VERIFIER_TOP_K=10
CONTEXT_PLANNER_BUDGET=3000
CONTEXT_RESEARCHER_BUDGET=6000
CONTEXT_WRITER_BUDGET=8000
CONTEXT_VERIFIER_BUDGET=8000
CONTEXT_TOOL_RESULT_THRESHOLD=2500
CONTEXT_DEDUP_SIMILARITY_THRESHOLD=0.92
CONTEXT_MAX_TOOL_RESULT_CHARS=12000
CONTEXT_MAX_EVIDENCE_CHARS=1800
# Optional Level-2 LLM evidence extraction for overlong Tool Results.
CONTEXT_LLM_EXTRACTOR=false
MCP_TIMEOUT_SECONDS=20
